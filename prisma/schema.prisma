generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  PROF_PRINCIPAL
  PROF
  ELEVE
}

enum IndexationStatus {
  PENDING
  PROCESSING
  INDEXED
  ERROR
}

enum VisibilityScope {
  STUDENTS_ONLY
  AI_ONLY
  BOTH
}

enum DocumentType {
  COURS
  EXERCICES
  SUJET_DS
  CORRECTION_DS
  CORRECTION_EXERCICES
  SUJET_DM
  COMPLEMENTS
  AUTRE
}

enum ChatMode {
  EXPLIQUE
  REVISE
}

model User {
  id           String   @id @default(cuid())
  identifiant  String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  title        String   @default("M/Mme")
  role         Role
  tenantId     String   @map("tenant_id")
  isActive     Boolean  @default(true) @map("is_active")
  defaultQuota Int      @default(10) @map("default_quota")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  passions     String[] @default([])

  groupesOwned         Groupe[]              @relation("ProfGroupes")
  memberships          GroupeMembership[]
  conversations        Conversation[]
  quotas               QuotaChat[]
  schoolHolidays       SchoolHoliday[]
  studentChapterLevels StudentChapterLevel[]
  studentMistakeLogs   StudentMistakeLog[]
  flashcards           Flashcard[]

  @@index([tenantId])
  @@index([role])
  @@map("users")
}

model Groupe {
  id         String   @id @default(cuid())
  profId     String   @map("prof_id")
  name       String
  schoolYear String   @map("school_year")
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  prof           User               @relation("ProfGroupes", fields: [profId], references: [id])
  memberships    GroupeMembership[]
  chapitres      Chapitre[]
  annonces       Annonce[]
  cours          CoursPlanifie[]
  coursTemplates CoursTemplate[]
  datesDS        DateDS[]
  conversations  Conversation[]

  focusConcepts String[] @default([])
  availableTags String[] @default(["Unité", "Cours", "Calcul", "Lecture d'énoncé"])

  @@index([profId])
  @@map("groupes")
}

model GroupeMembership {
  id          String   @id @default(cuid())
  eleveId     String   @map("eleve_id")
  groupeId    String   @map("groupe_id")
  teacherNote String?  @map("teacher_note")
  joinedAt    DateTime @default(now()) @map("joined_at")

  eleve  User   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  groupe Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@unique([eleveId, groupeId])
  @@map("groupe_memberships")
}

model Chapitre {
  id        String   @id @default(cuid())
  groupeId  String   @map("groupe_id")
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groupe               Groupe                @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  documents            Document[]
  annonces             Annonce[]
  datesDS              DateDSChapitre[]
  studentChapterLevels StudentChapterLevel[]
  studentMistakes      StudentMistakeLog[]
  flashcards           Flashcard[]

  focusConcepts String[] @default([])
  availableTags String[] @default([])

  @@index([groupeId])
  @@map("chapitres")
}

model Document {
  id            String           @id @default(cuid())
  chapitreId    String           @map("chapitre_id")
  fileName      String           @map("file_name")
  fileType      String           @map("file_type")
  storageUrl    String           @map("storage_url")
  extractedText String?          @map("extracted_text")
  indexStatus   IndexationStatus @default(PENDING) @map("index_status")
  indexError    String?          @map("index_error")
  fileSize      Int?             @map("file_size")
  visibility    VisibilityScope  @default(BOTH)
  docType       DocumentType     @default(AUTRE) @map("doc_type")
  keywords      String[]         @default([])
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  chapitre Chapitre        @relation(fields: [chapitreId], references: [id], onDelete: Cascade)
  chunks   DocumentChunk[]

  @@index([chapitreId])
  @@map("documents")
}

model StudentChapterLevel {
  id         String   @id @default(cuid())
  eleveId    String   @map("eleve_id")
  chapitreId String   @map("chapitre_id")
  level      Float    @default(2.5) // Default level if no history
  history    Json?    @default("[]") // Recent deltas for 0.5 cap
  updatedAt  DateTime @updatedAt @map("updated_at")

  eleve    User     @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  chapitre Chapitre @relation(fields: [chapitreId], references: [id], onDelete: Cascade)

  @@unique([eleveId, chapitreId])
  @@index([eleveId])
  @@index([chapitreId])
  @@map("student_chapter_levels")
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String                      @map("document_id")
  content    String
  embedding  Unsupported("vector(512)")?
  page       Int?
  section    String?
  chunkIndex Int                         @map("chunk_index")
  createdAt  DateTime                    @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

model Annonce {
  id          String   @id @default(cuid())
  groupeId    String   @map("groupe_id")
  chapitreId  String?  @map("chapitre_id")
  title       String
  content     String
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  groupe   Groupe    @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  chapitre Chapitre? @relation(fields: [chapitreId], references: [id], onDelete: SetNull)

  @@index([groupeId])
  @@map("annonces")
}

model CoursPlanifie {
  id          String    @id @default(cuid())
  groupeId    String    @map("groupe_id")
  templateId  String?   @map("template_id")
  dateTime    DateTime  @map("date_time")
  endTime     DateTime? @map("end_time")
  title       String
  room        String?
  isCancelled Boolean   @default(false) @map("is_cancelled")
  isException Boolean   @default(false) @map("is_exception")
  isDS        Boolean   @default(false) @map("is_ds")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  groupe   Groupe         @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  template CoursTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([groupeId])
  @@index([dateTime])
  @@index([templateId])
  @@map("cours_planifies")
}

model SchoolHoliday {
  id        String   @id @default(cuid())
  profId    String   @map("prof_id")
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prof User @relation(fields: [profId], references: [id], onDelete: Cascade)

  @@index([profId])
  @@map("school_holidays")
}

model CoursTemplate {
  id        String   @id @default(cuid())
  groupeId  String   @map("groupe_id")
  dayOfWeek Int      @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  room      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groupe         Groupe          @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  coursPlanifies CoursPlanifie[]

  @@index([groupeId])
  @@map("cours_templates")
}

model DateDS {
  id        String   @id @default(cuid())
  groupeId  String   @map("groupe_id")
  date      DateTime
  title     String
  keywords  String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groupe         Groupe           @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  chapitres      DateDSChapitre[]
  conversations  Conversation[]

  @@index([groupeId])
  @@map("dates_ds")
}

model DateDSChapitre {
  id         String @id @default(cuid())
  dateDSId   String @map("date_ds_id")
  chapitreId String @map("chapitre_id")

  dateDS   DateDS   @relation(fields: [dateDSId], references: [id], onDelete: Cascade)
  chapitre Chapitre @relation(fields: [chapitreId], references: [id], onDelete: Cascade)

  @@unique([dateDSId, chapitreId])
  @@map("date_ds_chapitres")
}

model Conversation {
  id                 String   @id @default(cuid())
  eleveId            String   @map("eleve_id")
  groupeId           String   @map("groupe_id")
  mode               ChatMode
  dateDSId           String?  @map("date_ds_id")
  chapitreId         String?  @map("chapitre_id")
  chapitresReviseIds String[] @default([]) @map("chapitres_revise_ids")
  difficultyLevel    Int      @default(2) @map("difficulty_level")
  notionsToReview    String[] @default([]) @map("notions_to_review")
  consecutiveFails   Int      @default(0) @map("consecutive_fails")

  // New state fields for advanced REVISE mode
  difficultyMode      String  @default("AUTO") @map("difficulty_mode")
  currentChapterId    String? @map("current_chapter_id")
  chapterStreak       Int     @default(0) @map("chapter_streak")
  exerciseTypes       String[] @default(["EXERCICE", "QCM", "OPEN"]) @map("exercise_types")
  selectedKeyword     String?  @map("selected_keyword")
  currentQuestionType String? @map("current_question_type")
  questionTypeStreak  Int     @default(0) @map("question_type_streak")
  lastQuestionChunks  Json?   @map("last_question_chunks")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  eleve              User                @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  groupe             Groupe              @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  dateDS             DateDS?             @relation(fields: [dateDSId], references: [id], onDelete: SetNull)
  messages           Message[]
  studentMistakeLogs StudentMistakeLog[]

  @@index([eleveId])
  @@index([groupeId])
  @@map("conversations")
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String   @map("conversation_id")
  role            String
  content         String
  sourceCitations Json?    @map("source_citations")
  createdAt       DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model QuotaChat {
  id               String   @id @default(cuid())
  eleveId          String   @map("eleve_id")
  date             DateTime @db.Date
  chatsUsed        Int      @default(0) @map("chats_used")
  chatsMax         Int      @map("chats_max")
  bonusChats       Int      @default(0) @map("bonus_chats")
  hasRequestedMore Boolean  @default(false) @map("has_requested_more")

  eleve User @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@unique([eleveId, date])
  @@index([eleveId])
  @@map("quota_chats")
}

model StudentMistakeLog {
  id             String   @id @default(cuid())
  eleveId        String   @map("eleve_id")
  chapitreId     String?  @map("chapitre_id")
  conversationId String   @map("conversation_id")
  errorType      String   @map("error_type")
  tags           String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")

  eleve        User         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  chapitre     Chapitre?    @relation(fields: [chapitreId], references: [id], onDelete: SetNull)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([eleveId])
  @@index([chapitreId])
  @@map("student_mistake_logs")
}

model Flashcard {
  id         String   @id @default(cuid())
  eleveId    String   @map("eleve_id")
  chapitreId String?  @map("chapitre_id")
  question   String
  reponse    String
  createdAt  DateTime @default(now()) @map("created_at")

  eleve      User       @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  chapitre   Chapitre?  @relation(fields: [chapitreId], references: [id], onDelete: SetNull)

  @@index([eleveId])
  @@index([chapitreId])
  @@map("flashcards")
}

